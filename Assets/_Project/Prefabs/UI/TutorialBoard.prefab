      m_Calls: []
  m_text: "Z Q S D (ou W A S D) : marcher \xB7 Maj : courir \xB7 Espace : sauter\nR
    : prendre et encocher une fl\xE8che\nClic gauche maintenu : tendre la corde\nRel\xE2cher
    : tirer\nClic droit : viser (zoom)\nE : interagir \xB7 T : voyage rapide \xB7
    \xC9chap : menu\nAstuce : visez un peu au-dessus de la cible, la fl\xE8che tombe
    !"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 7cad74a9048481f438ccaed0462b93f5, type: 2}
  m_sharedMaterial: {fileID: -1224603437709558952, guid: 7cad74a9048481f438ccaed0462b93f5, type: 2}
